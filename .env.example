# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=encryption-aesgcm
# MUXCORE_INSECURE_DISABLE_TLS=true
#
# Bootstrap key (hex, 32 bytes). Used only when ENCRYPTION_KEY_FILE has no JSON keyring;
# persisted to ENCRYPTION_KEY_FILE on first boot. Ignored when a JSON keyring exists on disk.
# ENCRYPTION_MASTER_KEY=
#
# Keyring path (mode 0600). Back this file up — losing it loses all ciphertext.
# ENCRYPTION_KEY_FILE=/var/lib/encryption-aesgcm/master.key
#
# Loopback-only by default (Encrypt/Decrypt/RotateKey have no auth).
# ENCRYPTION_GRPC_ADDR=127.0.0.1:9601
